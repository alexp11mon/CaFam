# Copia este archivo a .env.local (app) y .env.test.local (tests de BD) y rellena los valores.
# Nunca subas valores reales a git.

# URL del proyecto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Clave publicable (sb_publishable_...; la antigua "anon" también vale)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (Vercel y .env.local): autentica el cron de keep-alive y la
# sincronización (spec 007). También en .env.test.local, con el mismo valor que
# `cron_secret` en Vault de dev, para `npm run test:db`
CRON_SECRET=

# Solo servidor (Vercel y .env.local): cliente OAuth de Google para la sincronización (spec 007)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Solo servidor (Vercel, .env.local y .env.test.local): clave de Groq para el
# asistente de chat (spec 015). Nunca con prefijo NEXT_PUBLIC_ (constitución P4)
GROQ_API_KEY=

# Solo servidor, solo en Vercel (producción): dirección pública a la que Google
# manda los avisos de cambios (spec 020), p. ej.
# https://calendario-familia-five.vercel.app/api/sync/google-push. Vacía en dev
# y en las previews: no se crean canales y los calendarios se miran cada 15 min
SYNC_PUSH_URL=

# Solo en .env.test.local, para crear y borrar usuarios de prueba en `npm run test:db`.
# Nunca en Vercel ni en src/ (constitución P4)
SUPABASE_SECRET_KEY=
